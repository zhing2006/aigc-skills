GOOGLE_CLOUD_API_KEY = "your_google_api_key_here"
GOOGLE_CLOUD_PROJECT = "your_project_name"
GOOGLE_CLOUD_LOCATION = "global"
USE_VERTEX_AI = "false"
ELEVENLABS_API_KEY = "your_elevenlabs_api_key_here"
OPENAI_API_KEY = "your_openai_api_key_here"
OPENAI_API_BASE = "https://api.openai.com/v1"
USE_AZURE_OPENAI = "false"
AZURE_OPENAI_API_VERSION = "2025-04-01-preview"
TRIPO_API_KEY = "your_tripo_api_key_here"
TRIPO_API_BASE_URL = "https://api.tripo3d.ai/v2/openapi"
DASHSCOPE_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_API_KEY = "your_dashscope_api_key_here"
# Native async video API host (HappyHorse). Override for other regions, e.g.
# https://dashscope-intl.aliyuncs.com (Singapore) / https://dashscope-us.aliyuncs.com (US).
DASHSCOPE_VIDEO_BASE_URL = "https://dashscope.aliyuncs.com"
VOLCENGINE_API_KEY = "your_volcengine_api_key_here"
VOLCENGINE_API_BASE = "https://ark.cn-beijing.volces.com/api/v3"
# Volcengine speech (TTS / Voice Clone / Voice Design). API Key from console > Speech > API Key.
VOLCENGINE_TTS_API_KEY = "your_volcengine_tts_api_key_here"
VOLCENGINE_TTS_BASE = "https://openspeech.bytedance.com"
# Voice management (list/order/renew) only: speech App ID + account Access Key / Secret Key.
VOLCENGINE_TTS_APPID = "your_volcengine_tts_appid_here"
VOLCENGINE_ACCESS_KEY = "your_volcengine_access_key_here"
VOLCENGINE_SECRET_KEY = "your_volcengine_secret_key_here"
